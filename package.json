{
  "name": "yi-at-first-sight",
  "version": "0.1.0",
  "scripts": {
    "faces": "node -e \"const fs=require('fs');const f='src/features/ring/faces.json';if(!fs.existsSync(f))fs.writeFileSync(f,process.env.FACES_JSON||fs.readFileSync('src/features/ring/faces.example.json'))\"",
    "dev": "npm run -s faces && vite",
    "build": "npm run -s faces && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayford295/Yi-at-First-Sight.git"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@types/three": "^0.186.0",
    "@vladmandic/face-api": "^1.7.15",
    "leaflet": "^1.9.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "description": "Yi at First Sight: a private bilingual love map and games for Yifan and Jingyi"
}
