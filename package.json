{
  "name": "yi",
  "version": "1.8.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "ring:pack": "for r in hers hers_v1 his; do npx -y @gltf-transform/cli@4 optimize public/media/ring/meridian_$r.glb public/media/ring/meridian_$r.glb --compress meshopt --texture-compress false; done",
    "gate": "node scripts/gate-hash.mjs",
    "ring:thumbs": "python3 scripts/ring-thumbs.py",
    "banner": "node scripts/banner.ts",
    "icon": "node scripts/icon.ts && python3 scripts/icon-png.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayford295/YI.git"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "leaflet": "^1.9.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "description": "Yi at First Sight: a private bilingual love map and games for Yifan and Jingyi"
}
